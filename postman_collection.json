    {
      "name": "search posts by #Яндекс",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ответ должен содержать код статуса 200 и данные в формате json\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.response.to.be.withBody;\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "const target = pm.response.json();\r",
              "\r",
              "pm.test(\"Ответ содержит основные поля\", function () {\r",
              "    pm.expect(target).to.have.property(\"posts\");\r",
              "    pm.expect(target).to.have.property(\"hasPrev\");\r",
              "    pm.expect(target).to.have.property(\"hasNext\");\r",
              "    pm.expect(target).to.have.property(\"lastPage\");\r",
              "});\r",
              "\r",
              "pm.test(\"Поле posts является массивом\", function () {\r",
              "    pm.expect(target.posts).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Каждый пост содержит корректную структуру\", function () {\r",
              "    target.posts.forEach(post => {\r",
              "        pm.expect(post).to.have.property(\"id\");\r",
              "        pm.expect(post).to.have.property(\"title\");\r",
              "        pm.expect(post).to.have.property(\"text\");\r",
              "        pm.expect(post).to.have.property(\"tags\");\r",
              "        pm.expect(post).to.have.property(\"likesCount\");\r",
              "        pm.expect(post).to.have.property(\"commentsCount\");\r",
              "\r",
              "        pm.expect(post.id).to.be.a(\"number\");\r",
              "        pm.expect(post.title).to.be.a(\"string\");\r",
              "        pm.expect(post.text).to.be.a(\"string\");\r",
              "        pm.expect(post.tags).to.be.an(\"array\");\r",
              "        pm.expect(post.likesCount).to.be.a(\"number\");\r",
              "        pm.expect(post.commentsCount).to.be.a(\"number\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Поля пагинации имеют правильный тип\", function () {\r",
              "    pm.expect(target.hasPrev).to.be.a(\"boolean\");\r",
              "    pm.expect(target.hasNext).to.be.a(\"boolean\");\r",
              "    pm.expect(target.lastPage).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test('Каждый пост содержит тег \"Яндекс\"', function () {\r",
              "    const target = pm.response.json();\r",
              "\r",
              "    target.posts.forEach(post => {\r",
              "        pm.expect(post.tags).to.include(\"Яндекс\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Размер списка постов содержит 2 элемента\", function () {\r",
              "    const target = pm.response.json();\r",
              "    pm.expect(target.posts).to.have.lengthOf(2);\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
